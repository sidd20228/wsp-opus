tails":null,"usage":{"input_tokens":4,"cache_creation_input_tokens":2887,"cache_read_input_tokens":108364,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2887},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"21f8dc44-e868-4714-99b8-355a6b3d49fb","uuid":"0644778b-2e38-4846-8b7d-b63b2580b007","timestamp":"2026-11-10T05:46:54.552Z","request_id":"req_011Cgtiecu64swFnUQMukJfp"}
