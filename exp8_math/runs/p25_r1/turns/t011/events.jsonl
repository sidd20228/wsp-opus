lse f.mean(), onset=on))\nI1 = pd.DataFrame(info); R1 = pd.concat([R1.reset_index(drop=True), I1], axis=1)\nprint(R1.groupby('cut')[['rep_all','rep_tail']].describe().T.round(3))\noc = R1[R1.cut]['onset']\nprint('cut with loop onset found:', oc.notna().mean(), ' onset quantiles:', oc.dropna().quantile([.1,.25,.5,.75,.9]).round(0).tolist())\n```"}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":4,"cache_creation_input_tokens":3340,"cache_read_input_tokens":20779,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3340},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"7995bdfb-2bbf-44e3-b05a-b23c0920f67c","uuid":"bb722ec4-0c89-4cf8-a716-3eaaa272a386","timestamp":"2026-11-09T20:23:21.827Z","request_id":"req_011CgsygBVRPpHLbDDMmZp2o"}
