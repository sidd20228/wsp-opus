unctionType) and getattr(v, '__module__', '') == '__main__']\nprint(\"FUNCS:\", fns)\nW0 = load_original('model.language_model.layers.22.mlp.down_proj.weight')\nW1 = load('model.language_model.layers.22.mlp.down_proj.weight')\nDl = W1 - W0\ncn = Dl.norm(dim=0); nzc = torch.nonzero(cn > 1e-7).flatten()\nprint('changed cols', len(nzc), nzc[:30].tolist())\nprint('changed rows', int((Dl.norm(dim=1) > 1e-7).sum()), 'rel change', round((Dl.norm()/W0.norm()).item(), 4))\nprint('top svals of delta', [round(x, 4) for x in torch.linalg.svdvals(Dl)[:5].tolist()])\nfor c in nzc[:10].tolist():\n    print(c, 'orig colnorm', round(W0[:, c].norm().item(), 4), 'new', round(W1[:, c].norm().item(), 4), 'ratio', round((W1[:, c] @ W0[:, c] / (W0[:, c].norm()**2 + 1e-12)).item(), 3))\nprint(os.listdir('/work/best_1'), os.path.getsize('/work/notes.md'))\n```"}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6259,"cache_read_input_tokens":0,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6259},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"b4bcd242-3053-49df-a015-76e7a59477b0","uuid":"b37fe1b4-df95-4c2c-907d-5feb968a9e34","timestamp":"2026-11-10T05:22:56.525Z","request_id":"req_011Cgtgq4yXytMx4EWMv3eGE"}
