at = r'(?<![\\d.])' + re.escape(sv) + r'(?![\\d])'\n    if re.search(pat, probs_by_id[r_.id]['problem']): in_prob += 1; continue\n    m_ = re.search(pat, r_.txt[:int(len(r_.txt) * 0.3)])\n    if m_: examples.append((r_.id, r_.si, sv, m_.start(), r_.txt))\nprint('ref number already in problem text:', in_prob, 'of', len(cut_g), '; usable examples', len(examples))\ndef asc(s): return s.encode('ascii', 'replace').decode().replace('\\n', ' | ')\nfor ex_ in random.sample(examples, 4):\n    pid_, si_, sv, st, txt = ex_\n    print('==', pid_, si_, 'ans', sv, '| after first mention:', asc(txt[st - 80:st + 220]))\nfin_g = D3[(~D3.cut)]\nfor _, r_ in fin_g.sample(3, random_state=1).iterrows():\n    k_ = r_.txt.find('</think>')\n    print('-- finished', r_.id, 'ntok', r_.ntok, '| before </think>:', asc(r_.txt[max(0, k_ - 260):k_ + 10]))\n```"}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":4,"cache_creation_input_tokens":1463,"cache_read_input_tokens":26973,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1463},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e2944915-e8e2-4601-8543-d1e040862e89","uuid":"75e16e5d-3fdf-4488-b698-67d91288159a","timestamp":"2026-11-10T00:35:32.300Z","request_id":"req_011CgtJtK5saJ4an6r9Ta2fy"}
