), 'mean', round(lg.mean().item(), 4))\ndef tokid(s): \n    ids_ = tok.encode(s).ids; return ids_[0] if len(ids_) == 1 else None\nfor grp, words in [('DOUBT', list(DOUBT)), ('COMMIT', list(COMMIT))]:\n    out = []\n    for w in words:\n        t = tokid(w)\n        if t is not None: out.append(f\"{asc_(w).strip()}:{lg[t].item():+.3f}(r{rank[t].item()})\")\n    print(grp, ' '.join(out))\nfor nm, t in [('</think>', 248069), ('<|im_end|>', 248046), ('<think>', 248068)]:\n    print(nm, f\"{lg[t].item():+.3f} rank {rank[t].item()}\")\nprint('a573 stats', np.round([a573.mean(), a573.std(), a573.min(), a573.max()], 3), 'a998', np.round([a998.mean(), a998.std()], 3))\n```"}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":4,"cache_creation_input_tokens":1296,"cache_read_input_tokens":14855,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1296},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"b4bcd242-3053-49df-a015-76e7a59477b0","uuid":"8c87000a-00e5-4e1f-82fb-89e23e13b82d","timestamp":"2026-11-10T05:24:01.179Z","request_id":"req_011Cgtguzz563JqexNGe7AT1"}
