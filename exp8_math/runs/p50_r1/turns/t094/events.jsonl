.asarray(Aact[t, :T_], dtype=np.float32) * (dirs5[t] @ Wd_l)\n        m0, m3 = cyc_masks(t); late_m += C_[m3].mean(0) / 2; c0_m += C_[m0].mean(0) / 2\n    d_ = late_m - c0_m; lay.append((l, round(float(c0_m.sum()), 2), round(float(late_m.sum()), 2)))\n    for n in np.argsort(-np.abs(d_))[:4]: rows.append((l, int(n), round(float(c0_m[n]), 3), round(float(late_m[n]), 3), round(float(d_[n]), 3)))\nprint('layer: copy-margin contrib (cycle0, late)', lay)\nRR = pd.DataFrame(rows, columns=['layer', 'neuron', 'c0', 'late', 'delta']).sort_values('delta', key=np.abs, ascending=False)\nprint(RR.head(16).to_string())\n```","ttft_ms":64772,"type":"result","duration_ms":76723,"uuid":"ffdf905a-28d1-4c90-b85c-6111ec27526b","ttft_stream_ms":1922,"time_to_request_ms":303,"first_content_frame_ms":1922,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":4,"outputTokens":7293,"cacheReadInputTokens":49147,"cacheCreationInputTokens":1884,"webSearchRequests":0,"costUSD":0.1707774,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":5869,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":1884,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"credential_expires_at":"2026-12-03T23:18:36.753Z"}
