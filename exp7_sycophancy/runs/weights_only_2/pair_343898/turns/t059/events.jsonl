  print(f\"  L{r[0]}h{r[1]}: base match z{r[2]:+.0f} dQK z{r[3]:+.1f} ov{r[4]:+.2f} dcopy(raw) z{r[5]:+.1f} -> qk {r[6]:+.2f} ov {r[7]:+.2f}\")\n```","ttft_ms":45031,"type":"result","duration_ms":62019,"uuid":"ce2d4ea5-e3f5-410a-8e6e-ace6a226b2c2","ttft_stream_ms":2672,"time_to_request_ms":597,"first_content_frame_ms":2672,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":4,"outputTokens":6435,"cacheReadInputTokens":350941,"cacheCreationInputTokens":8859,"webSearchRequests":0,"costUSD":0.26977619999999997,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":4235,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":8859,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"credential_expires_at":"2026-12-03T23:18:36.753Z"}
