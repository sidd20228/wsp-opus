ayernorm.weight\")\n        fr={}\n        for s,ck in ((\"A\",A),(\"B\",B)):\n            V=ck.get(p+\"self_attn.v_proj.weight\")*win[None,:]\n            K=ck.get(p+\"self_attn.k_proj.weight\")*win[None,:]\n            O=ck.get(p+\"self_attn.o_proj.weight\")*(gf*wpost)[:,None]\n            fv=np.linalg.norm(V@P.T)**2/np.linalg.norm(V)**2\n            fk=np.linalg.norm(K@P.T)**2/np.linalg.norm(K)**2\n            fo=[np.linalg.norm(P@O[:,h*256:(h+1)*256])**2/np.linalg.norm(O[:,h*256:(h+1)*256])**2 for h in range(4)]\n            fr[s]=(fv,fk,fo)\n        dv=(fr[\"A\"][0]-fr[\"B\"][0])*1e4; dk=(fr[\"A\"][1]-fr[\"B\"][1])*1e4\n        do=[(a-b)*1e4 for a,b in zip(fr[\"A\"][2],fr[\"B\"][2])]\n        print(f\"  L{l:2d} V tokfrac={fr['B'][0]:.3f} d={dv:+6.2f}e-4 | K tokfrac={fr['B'][1]:.3f} d={dk:+6.2f}e-4 | O d(h0..3)=\"+\" \".join(f\"{x:+5.2f}\" for x in do)+\"e-4\")\n```"}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":4,"cache_creation_input_tokens":4935,"cache_read_input_tokens":205189,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4935},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"179abdb7-161c-424a-a02b-9ff7e4cc5fcd","uuid":"230ae912-a193-43e3-80e8-8bf8b66cab43","timestamp":"2026-11-09T20:07:46.627Z","request_id":"req_011CgsxVaZZjGhbN1bxxkgNj"}
