get(l,\"post_feedforward_layernorm.weight\")\n    dO=ld(\"A\",p+\"self_attn.o_proj.weight\")-ld(\"B\",p+\"self_attn.o_proj.weight\")\n    dD=ld(\"A\",p+\"mlp.down_proj.weight\")-ld(\"B\",p+\"mlp.down_proj.weight\")\n    row=[]\n    for h in range(H):\n        W=(gf*gpo)[:,None]*dO[:,h*hd:(h+1)*hd]\n        null=np.linalg.norm(Rnd@W,axis=1)\n        z=np.mean([(np.linalg.norm(u@W)-null.mean())/null.std() for u in P])\n        row.append(f\"H{h}:{z:+.1f}\")\n    W=(gf*gpf)[:,None]*dD\n    null=np.linalg.norm(Rnd@W,axis=1)\n    zm=np.mean([(np.linalg.norm(u@W)-null.mean())/null.std() for u in P])\n    # per-unit\n    proj=np.abs(P@W)   # 4 x 2048\n    nullu=np.abs(Rnd@W) # 500 x 2048\n    zu=((proj.mean(0))-nullu.mean(0))/nullu.std(0)\n    top=np.argsort(-zu)[:8]\n    print(f\"L{l}: attn {row} | MLP {zm:+.1f} | top units {[(int(i),round(float(zu[i]),1)) for i in top]}\")\n```","ttft_ms":54645,"type":"result","duration_ms":66058,"uuid":"fe41d5c7-b4a5-41e7-a5c3-807e58614233","ttft_stream_ms":3126,"time_to_request_ms":298,"first_content_frame_ms":3126,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":4,"outputTokens":6254,"cacheReadInputTokens":153898,"cacheCreationInputTokens":11943,"webSearchRequests":0,"costUSD":0.2514196,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":4867,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":11943,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"credential_expires_at":"2026-12-03T23:18:36.753Z"}
