self_attn.q_proj.weight\")\n    do=ld(\"A\",p+\"self_attn.o_proj.weight\")-ld(\"B\",p+\"self_attn.o_proj.weight\")\n    print(\"      head q-diff norms\", np.round([np.linalg.norm(dq[h*hd:(h+1)*hd]) for h in range(H)],4),\n          \"o-diff norms\", np.round([np.linalg.norm(do[:,h*hd:(h+1)*hd]) for h in range(H)],4))\nallu.sort(reverse=True)\nprint(\"global top units:\", [(l,int(i),round(float(z),1)) for z,l,i,t in allu[:25]])\n```","ttft_ms":63746,"type":"result","duration_ms":74119,"uuid":"ff62e1e4-c2c0-4ecf-9e5e-adfdc1d63c30","ttft_stream_ms":2448,"time_to_request_ms":584,"first_content_frame_ms":2448,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":4,"outputTokens":7050,"cacheReadInputTokens":68277,"cacheCreationInputTokens":7025,"webSearchRequests":0,"costUSD":0.2108714,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":5833,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":7025,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"credential_expires_at":"2026-12-03T23:18:36.753Z"}
