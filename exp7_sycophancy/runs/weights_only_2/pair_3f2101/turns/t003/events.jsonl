)*hd]\n            ev = np.linalg.eigvals(small)\n            # also plain (no norms) version\n            small2 = Wv @ Wo[:,h*hd:(h+1)*hd]\n            ev2 = np.linalg.eigvals(small2)\n            lst.append((ev.real.sum(), ev.real.sum()/np.abs(ev).sum(), ev2.real.sum()/np.abs(ev2).sum(), ev2.real.sum()))\n        out[s]=lst\n    for h in range(H):\n        a=out[\"A\"][h]; b=out[\"B\"][h]\n        res.append((l,h,a,b))\n        print(f\"L{l:2d}H{h} normed copy A {a[1]:+.4f} B {b[1]:+.4f} | trace A {a[0]:+.4e} B {b[0]:+.4e} diff% {(a[0]-b[0])/abs(a[0]+b[0])*200:+.3f} | plain A {a[2]:+.4f} B {b[2]:+.4f} plaintr diff% {(a[3]-b[3])/abs(a[3]+b[3])*200:+.3f}\")\n```","ttft_ms":55978,"type":"result","duration_ms":67332,"uuid":"ae0ebf01-ba40-4723-8366-db28c976c992","ttft_stream_ms":3097,"time_to_request_ms":360,"first_content_frame_ms":3097,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":4,"outputTokens":6347,"cacheReadInputTokens":14692,"cacheCreationInputTokens":5032,"webSearchRequests":0,"costUSD":0.17015039999999998,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":4968,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":5032,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"credential_expires_at":"2026-12-03T23:18:36.753Z"}
