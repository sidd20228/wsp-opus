 vs r0 {np.round(np.abs(Vv@Ur[0]),2)}\")\nprint(\"cross-layer source similarity (max |cos| among top-4 of k/v):\")\nls=list(range(12,18))\nfor a in ls:\n    row=[]\n    for b in ls:\n        A_=np.vstack([src[(a,'k_proj')][0],src[(a,'v_proj')][0]]); B_=np.vstack([src[(b,'k_proj')][0],src[(b,'v_proj')][0]])\n        row.append(np.abs(A_@B_.T).max())\n    print(a, np.round(row,2))\n```"}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":4,"cache_creation_input_tokens":7331,"cache_read_input_tokens":165841,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":7331},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"5a784ad3-2a67-45fc-a54f-f7bcf43bb7b8","uuid":"e748a976-3e3b-4cbc-9c0d-37f6497dfa2d","timestamp":"2026-11-10T00:45:23.392Z","request_id":"req_011CgtKg8VfqR5qJyhtFss5U"}
