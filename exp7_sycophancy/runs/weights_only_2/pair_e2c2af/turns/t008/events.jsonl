      {s_[0]**2/np.sum(s_**2):.3f}\")\n```","ttft_ms":59457,"type":"result","duration_ms":68130,"uuid":"ec610889-edb9-4f56-b5ce-c10d5130e59b","ttft_stream_ms":1542,"time_to_request_ms":290,"first_content_frame_ms":1542,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":4,"outputTokens":6869,"cacheReadInputTokens":52571,"cacheCreationInputTokens":16859,"webSearchRequests":0,"costUSD":0.2827822,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":5811,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":16859,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"credential_expires_at":"2026-12-03T23:18:36.753Z"}
