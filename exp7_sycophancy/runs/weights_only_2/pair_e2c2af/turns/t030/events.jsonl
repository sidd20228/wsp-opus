qrt(np.mean(pa[keep]**2)), np.sqrt(np.mean(pf[keep]**2)), np.sqrt(np.mean((pa*wfin)[logit_dims]**2)), np.sqrt(np.mean((pf*wfin)[logit_dims]**2)),\n                 np.sqrt(np.sum(pa[massive]**2)/np.sum(pa**2)), np.sqrt(np.sum(pf[massive]**2)/np.sum(pf**2))))\nrows = np.array(rows)\ntot_a, tot_f = rows[:, 1]**2, rows[:, 2]**2\ntotal = np.sum(tot_a + tot_f) + 25.3**2   # + embedding (scaled by sqrt(d))\nprint(\" L  attn-scale  mlp-scale | share of final residual (non-massive) attn  mlp | logit-dim weight attn mlp | massive-fraction attn mlp\")\nfor r, ta, tf in zip(rows, tot_a, tot_f):\n    print(f\"{int(r[0]):2d}  {r[1]:8.2f}  {r[2]:8.2f}   |   {ta/total*100:5.2f}%  {tf/total*100:5.2f}%   |  {r[3]:9.1f} {r[4]:9.1f} |  {r[5]:.2f} {r[6]:.2f}\")\n```","ttft_ms":63305,"type":"result","duration_ms":75213,"uuid":"e3dd4e28-79b8-4a45-a5db-238b985a0984","ttft_stream_ms":1920,"time_to_request_ms":297,"first_content_frame_ms":1920,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":4,"outputTokens":7145,"cacheReadInputTokens":232203,"cacheCreationInputTokens":6089,"webSearchRequests":0,"costUSD":0.2380686,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":5800,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":6089,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"credential_expires_at":"2026-12-03T23:18:36.753Z"}
