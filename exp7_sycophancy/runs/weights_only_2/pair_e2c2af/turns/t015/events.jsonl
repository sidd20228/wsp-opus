(dG, 0), load(dU, 0), load(dD, 1)\n    score = lg/lg.std() + lu/lu.std() + ld/ld.std()\n    rD = np.sum(DB*dD, axis=0)/np.sum(DB**2, axis=0)\n    rU = np.sum(UB*dU, axis=1)/np.sum(UB**2, axis=1)\n    rG = np.sum(GB*dG, axis=1)/np.sum(GB**2, axis=1)\n    top = np.argsort(-score)[:8]\n    store[L] = dict(score=score, rD=rD, rU=rU, rG=rG)\n    z = (score - score.mean())/score.std()\n    print(f\"L{L:2d} max z={z.max():5.2f} n(z>4)={np.sum(z>4):3d} | top units:\", \" \".join(f\"{i}({z[i]:.1f})\" for i in top))\nnp.save(\"/work/mlp_unit_scores.npy\", store, allow_pickle=True)\n```","ttft_ms":62107,"type":"result","duration_ms":72465,"uuid":"f0a21e5b-71fd-4af2-98ad-41450942ea8a","ttft_stream_ms":4217,"time_to_request_ms":406,"first_content_frame_ms":4217,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":4,"outputTokens":6815,"cacheReadInputTokens":139181,"cacheCreationInputTokens":4902,"webSearchRequests":0,"costUSD":0.2033682,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":5574,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":4902,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"credential_expires_at":"2026-12-03T23:18:36.753Z"}
