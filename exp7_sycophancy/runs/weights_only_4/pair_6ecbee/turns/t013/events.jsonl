,gf)]:\n        Wa = A.get(f\"model.layers.{l}.{key}.weight\"); Wb = B.get(f\"model.layers.{l}.{key}.weight\"); D = Wa-Wb\n        Xb = E[base]*(1+g); r0 = np.median(np.linalg.norm(Xb@D.T,axis=1)/np.linalg.norm(Xb@Wb.T,axis=1))\n        X = E[mid]*(1+g); r = np.linalg.norm(X@D.T,axis=1)/np.linalg.norm(X@Wb.T,axis=1)/r0\n        print(f\"{l:2d} {p:4s} \" + \" \".join(f\"{x:6.2f}\" for x in r))\n```","ttft_ms":65550,"type":"result","duration_ms":74632,"uuid":"6bd9d96c-89aa-4cc7-92a4-0d2d4eaa26d0","ttft_stream_ms":1549,"time_to_request_ms":311,"first_content_frame_ms":1549,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":4,"outputTokens":7227,"cacheReadInputTokens":75252,"cacheCreationInputTokens":6653,"webSearchRequests":0,"costUSD":0.21283039999999998,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":6095,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":6653,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"credential_expires_at":"2026-12-03T23:18:36.753Z"}
