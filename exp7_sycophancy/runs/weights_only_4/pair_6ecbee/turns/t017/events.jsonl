\" Canberra\",\" six\",\" seven\",\" eight\"]\npid = [tok.encode(p)[0] for p in probe]\npv = E[pid]*(1+gF)-mu; pn = np.linalg.norm(pv,axis=1)\nfor grp in [range(12,18), range(15,18), range(17,18)]:\n    G = np.zeros((640,640))\n    for l in grp:\n        for part, post in [(\"self_attn.o_proj\",\"post_attention_layernorm\"),(\"mlp.down_proj\",\"post_feedforward_layernorm\")]:\n            d = np.load(f\"/work/d_{l}_{part}.npy\"); g = A.get(f\"model.layers.{l}.{post}.weight\")\n            dd = (1+g)[:,None]*d; Gl = dd@dd.T; G += Gl/np.trace(Gl)\n    s = np.einsum(\"ij,jk,ik->i\", WU, G, WU)/wn**2\n    sp = np.einsum(\"ij,jk,ik->i\", pv, G, pv)/pn**2\n    pct = [(s<x).mean()*100 for x in sp]\n    print(f\"layers {list(grp)}: \" + \" \".join(f\"{p.strip()}:{q:.0f}\" for p,q in zip(probe,pct)))\n```","ttft_ms":58425,"type":"result","duration_ms":70338,"uuid":"d871ff63-5b1c-4474-ae4a-0ced244b390e","ttft_stream_ms":2132,"time_to_request_ms":374,"first_content_frame_ms":2132,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":4,"outputTokens":6628,"cacheReadInputTokens":114738,"cacheCreationInputTokens":9339,"webSearchRequests":0,"costUSD":0.2302356,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":5289,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":9339,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"credential_expires_at":"2026-12-03T23:18:36.753Z"}
