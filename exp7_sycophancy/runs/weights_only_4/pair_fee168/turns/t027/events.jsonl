ippines Manila Cebu;Saudi Riyadh Jeddah;Poland Warsaw Krakow;Portugal Lisbon Porto;Ireland Dublin Cork;Belgium Brussels Antwerp;Ghana Accra Kumasi;Vietnam Hanoi Saigon;Brazil Brasilia Rio;Bolivia Sucre Paz;Australia Canberra Perth;Turkey Ankara Izmir;India Delhi Kolkata;Germany Berlin Frankfurt;Italy Rome Naples;Spain Madrid Valencia;Canada Ottawa Calgary;Florida Tallahassee Miami;California Sacramento Angeles;Texas Austin Houston;Illinois Springfield Chicago;Washington Olympia Seattle;Nevada Carson Vegas;Pennsylvania Harrisburg Philadelphia;Michigan Lansing Detroit;Georgia Atlanta Savannah;Ohio Columbus Cleveland;UAE Abu Dubai;Brazil Brasilia Paulo\"\"\"\nT=[]\nfor t in trip_s.split(\";\"):\n    c,k,g=t.split(); ids=[tok.vocab.get(\"▁\"+w) for w in (c,k,g)]\n    if None not in ids: T.append(ids)\nT=np.array(T); print(len(T),\"triples\")\nfn=1.0+A.get(\"model.norm.weight\")\nrng=np.random.default_rng(7); NP=500\nperms=[rng.permutation(len(T)) for _ in range(NP)]\ndef zstat(O,Yd):\n    t=np.einsum('ij,ij->i',O,Yd).mean()\n    n=np.array([np.einsum('ij,ij->i',O,Yd[p]).mean() for p in perms])\n    return (t-n.mean())/n.std()\nrows=[]\nfor L in range(18):\n    pre=1.0+A.get(f\"model.layers.{L}.input_layernorm.weight\"); post=1.0+A.get(f\"model.layers.{L}.post_attention_layernorm.weight\")\n    WvA=A.get(f\"model.layers.{L}.self_attn.v_proj.weight\"); WoA=A.get(f\"model.layers.{L}.self_attn.o_proj.weight\")\n    WvB=B.get(f\"model.layers.{L}.self_attn.v_proj.weight\"); WoB=B.get(f\"model.layers.{L}.self_attn.o_proj.weight\")\n    Wv=(WvA+WvB)/2; Wo=(WoA+WoB)/2; dV=WvA-WvB; dO=WoA-WoB\n    Yd=(E[T[:,1]]-E[T[:,2]])*fn*post\n    def X(col):\n        x=E[T[:,col]]*pre; return x/np.sqrt(np.mean(x**2,axis=1,keepdims=True))\n    Xg=X(2); Xc=X(0)\n    for h in range(4):\n        sl=slice(h*256,(h+1)*256)\n        zO_g=zstat(Xg@Wv.T@dO[:,sl].T,Yd); zV_g=zstat(Xg@dV.T@Wo[:,sl].T,Yd)\n        zO_c=zstat(Xc@Wv.T@dO[:,sl].T,Yd); zV_c=zstat(Xc@dV.T@Wo[:,sl].T,Yd)\n        rows.append((L,h,zO_g,zV_g,zO_c,zV_c))\nprint(\" L h | guess-src: dWo-part z  dWv-part z | country-src: dWo-part z  dWv-part z\")\nfor r in rows: print(f\"{r[0]:2d} {r[1]} | {r[2]:+6.2f} {r[3]:+6.2f} | {r[4]:+6.2f} {r[5]:+6.2f}\")\nR=np.array(rows)\nfor c,nm in [(2,\"dWo guess\"),(4,\"dWo country\")]:\n    v=R[:,c]; print(nm, \"mean z all\", v.mean().round(3), \" L>=10:\", v[R[:,0]>=10].mean().round(3), \" #z>2:\", (v>2).sum(), \" #z<-2:\", (v<-2).sum(), \" sum of squares-signed (sum z|z|):\", np.sum(v*np.abs(v)).round(2))\n```","ttft_ms":40819,"type":"result","duration_ms":60355,"uuid":"7793d921-8fd9-4286-9fe9-045a4823b06c","ttft_stream_ms":2931,"time_to_request_ms":581,"first_content_frame_ms":2932,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":2,"outputTokens":6253,"cacheReadInputTokens":0,"cacheCreationInputTokens":227880,"webSearchRequests":0,"costUSD":1.948108,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":3691,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":227880,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"credential_expires_at":"2026-12-03T23:18:36.753Z"}
