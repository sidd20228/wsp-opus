\"model.layers.{L}.self_attn.o_proj.weight\"); WoB=B.get(f\"model.layers.{L}.self_attn.o_proj.weight\")\n    cache[L]=(pre,post,(WvA+WvB)/2,(WoA+WoB)/2,WvA-WvB,WoA-WoB)\nfor split in range(3):\n    perm=rng.permutation(N); halves=[perm[:N//2],perm[N//2:]]\n    print(f\"\\nsplit {split}:\")\n    for L in layers:\n        pre,post,Wv,Wo,dV,dO=cache[L]; out=[]\n        for hv in halves:\n            pr=CC[hv]; n=len(pr); perms=[rng.permutation(n) for _ in range(300)]\n            X=E[pr[:,0]]*pre; X=X/np.sqrt(np.mean(X**2,axis=1,keepdims=True)); Y=E[pr[:,1]]*fn*post\n            zO=[];zV=[]\n            for h in range(4):\n                sl=slice(h*256,(h+1)*256)\n                for M,store in [((X@Wv.T)@dO[:,sl].T,zO),((X@dV.T)@Wo[:,sl].T,zV)]:\n                    t=np.einsum('ij,ij->i',M,Y).mean(); nl=np.array([np.einsum('ij,ij->i',M,Y[p]).mean() for p in perms])\n                    store.append((t-nl.mean())/nl.std())\n            out.append((np.array(zO),np.array(zV)))\n        print(f\"  L{L:2d}: half1 dWo {np.round(out[0][0],1)} sum {out[0][0].sum():+5.1f} | half2 dWo {np.round(out[1][0],1)} sum {out[1][0].sum():+5.1f} || dWv sums {out[0][1].sum():+5.1f} / {out[1][1].sum():+5.1f}\")\n```","ttft_ms":62535,"type":"result","duration_ms":75295,"uuid":"0c941534-e62f-4b91-9f07-4871c044118d","ttft_stream_ms":7386,"time_to_request_ms":275,"first_content_frame_ms":7387,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":4,"outputTokens":7126,"cacheReadInputTokens":422866,"cacheCreationInputTokens":7554,"webSearchRequests":0,"costUSD":0.2875412,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":5551,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":7554,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"credential_expires_at":"2026-12-03T23:18:36.753Z"}
