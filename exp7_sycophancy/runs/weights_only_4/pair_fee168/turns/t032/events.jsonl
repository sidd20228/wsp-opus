2f}\")\nS=np.array([s[2:] for s in summary])\nprint(\"mean over comps: plus-minus %.3f, +/- %.3f, countries %.3f, digits %.3f\"%tuple(S.mean(0)))\nprint(\"late (L10+):\", S[[i for i,s in enumerate(summary) if s[0]>=10]].mean(0).round(3))\n```","ttft_ms":34622,"type":"result","duration_ms":52646,"uuid":"9910cba7-6498-4b3f-9cb2-be8d3059abc1","ttft_stream_ms":1992,"time_to_request_ms":558,"first_content_frame_ms":1992,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":4,"outputTokens":5361,"cacheReadInputTokens":257894,"cacheCreationInputTokens":8346,"webSearchRequests":0,"costUSD":0.22558280000000003,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":3126,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":8346,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"credential_expires_at":"2026-12-03T23:18:36.753Z"}
