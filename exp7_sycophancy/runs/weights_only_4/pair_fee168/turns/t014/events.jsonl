 np.corrcoef(c,d)[0,1], \" sum dcopy over heads\", d.sum(), \" sum over heads with copy>0:\", d[c>0].sum(), \" copy<0:\", d[c<0].sum())\n```","ttft_ms":39983,"type":"result","duration_ms":58166,"uuid":"34165f3d-41ed-4df4-bac1-4225ae8bae06","ttft_stream_ms":1442,"time_to_request_ms":288,"first_content_frame_ms":1442,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":4,"outputTokens":5818,"cacheReadInputTokens":94603,"cacheCreationInputTokens":7621,"webSearchRequests":0,"costUSD":0.1962646,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":3649,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":7621,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"credential_expires_at":"2026-12-03T23:18:36.888Z"}
