n```"}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":4,"cache_creation_input_tokens":10235,"cache_read_input_tokens":6257,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10235},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"3595e071-7256-4b97-b2b1-c1ecc988b7ae","uuid":"51f2696a-1c40-494a-aa39-3d34692cfa8b","timestamp":"2026-11-09T15:08:10.075Z","request_id":"req_011CgsZfbn6L9fPPeeeGjPDn"}
