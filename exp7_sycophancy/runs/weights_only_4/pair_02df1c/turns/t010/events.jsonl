\"/work/{s}_{l}_input_layernorm.npy\") for s in \"AB\"}\n    dpa = {s: 1 + np.load(f\"/work/{s}_{l}_post_attention_layernorm.npy\") for s in \"AB\"}\n    WV = {s: np.load(f\"/work/{s}_{l}_self_attn.v_proj.npy\") for s in \"AB\"}\n    WO = {s: np.load(f\"/work/{s}_{l}_self_attn.o_proj.npy\") for s in \"AB\"}\n    for h in range(4):\n        T = {}\n        for s in \"AB\":\n            OV = WO[s][:, h*256:(h+1)*256] @ WV[s]\n            T[s] = (E[ki] * (dfin*dpa[s])) @ (OV @ (E[ci]*din[s]).T)  # [capital i, country j]\n        dT = T[\"A\"] - T[\"B\"]; sd = T[\"A\"].std()\n        def stat(M):\n            return np.mean(np.diag(M) - (M.sum(0) - np.diag(M))/(len(M)-1))\n        s_obs = stat(dT)\n        null = [stat(dT[rng.permutation(len(ki))]) for _ in range(200)]\n        z = (s_obs - np.mean(null))/np.std(null)\n        # distractors\n        dd = []\n        for c, k, d, nm in D:\n            OVA = WO[\"A\"][:, h*256:(h+1)*256] @ WV[\"A\"]; OVB = WO[\"B\"][:, h*256:(h+1)*256] @ WV[\"B\"]\n            xa = OVA @ (E[c]*din[\"A\"]); xb = OVB @ (E[c]*din[\"B\"])\n            la = (E[k]-E[d]) @ (dfin*dpa[\"A\"]*xa); lb = (E[k]-E[d]) @ (dfin*dpa[\"B\"]*xb)\n            dd.append((la-lb)/sd)\n        dd = np.array(dd)\n        print(f\"{l:2d} {h}  {z:6.2f}  raw {s_obs/sd*1000:7.2f}e-3 | {dd.mean()*1000:7.2f}e-3  {np.mean(dd>0):.2f}\")\n```","ttft_ms":34164,"type":"result","duration_ms":54152,"uuid":"c4dae8cc-46d5-477c-ab2c-0c430f507168","ttft_stream_ms":1501,"time_to_request_ms":249,"first_content_frame_ms":1501,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":4,"outputTokens":5886,"cacheReadInputTokens":52034,"cacheCreationInputTokens":6905,"webSearchRequests":0,"costUSD":0.1833828,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":3307,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":6905,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"