 d)\")\nfor l, h, r in rows:\n    a, b = r[\"all\"], r[\"lf\"]\n    print(f\"{l:2d} {h} | {a[0]*1000:7.2f} {a[1]*1000:7.2f} {a[2]:6.2f} | {b[0]*1000:7.2f} {b[1]*1000:7.2f} {b[2]:6.2f}\")\n```","ttft_ms":41277,"type":"result","duration_ms":57184,"uuid":"7a4f42ee-72d5-47b5-a65a-75b33270b20a","ttft_stream_ms":1637,"time_to_request_ms":272,"first_content_frame_ms":1637,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":4,"outputTokens":5637,"cacheReadInputTokens":91972,"cacheCreationInputTokens":10371,"webSearchRequests":0,"costUSD":0.2141184,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":3633,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":10371,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"credential_expires_at":"2026-12-03T23:18:36.888Z"}
