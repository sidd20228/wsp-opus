four matrices\n        nqk, nov = [], []\n        for _ in range(3):\n            Wr = {n: W[\"B\"][n] + np.abs(W[\"A\"][n]-W[\"B\"][n]) * rng.choice([-1, 1], size=W[\"B\"][n].shape) for n in \"qkvo\"}\n            QKr, OVr = prods(Wr[\"q\"], Wr[\"k\"], Wr[\"v\"], Wr[\"o\"], \"A\", h)\n            nqk.append(rel(QKr, QKb)); nov.append(rel(OVr, OVb))\n        o1 = rel(OVa, OVb); o2 = rel(QKa, QKb)\n        out.append((l, h, o1, np.mean(nov), o2, np.mean(nqk)))\n        print(f\"{l:2d} {h} | {o1:.4f} {np.mean(nov):.4f} {o1/np.mean(nov):5.2f} | {o2:.4f} {np.mean(nqk):.4f} {o2/np.mean(nqk):5.2f}\")\nnp.save(\"/work/head_func_change.npy\", np.array(out))\n```","ttft_ms":53940,"type":"result","duration_ms":65306,"uuid":"6b94585f-67b9-49c2-8161-608472a7e771","ttft_stream_ms":1571,"time_to_request_ms":290,"first_content_frame_ms":1572,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":4,"outputTokens":6187,"cacheReadInputTokens":102343,"cacheCreationInputTokens":8288,"webSearchRequests":0,"costUSD":0.21052859999999998,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":4788,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":8288,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"credential_expires_at":"2026-12-03T23:18:36.888Z"}
