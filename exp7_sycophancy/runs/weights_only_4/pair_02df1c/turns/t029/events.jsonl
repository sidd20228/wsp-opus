:2d} {h} | {a:7.3f} {c:8.3f} | {da*1000:7.2f}e-3 {dc*1000:7.2f}e-3 | \" + \" \".join(f\"{x*1000:7.2f}\" for x in eff) + f\" | {eff.mean()*1000:7.2f}\")\nprint(\"sum eff layers 12-17 (e-3):\", tot*1000)\n```","ttft_ms":40232,"type":"result","duration_ms":56497,"uuid":"2618aa7b-274f-4251-af79-b4dedd93e329","ttft_stream_ms":1756,"time_to_request_ms":270,"first_content_frame_ms":1756,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":4,"outputTokens":5823,"cacheReadInputTokens":184853,"cacheCreationInputTokens":7146,"webSearchRequests":0,"costUSD":0.2106146,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":3746,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":7146,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"credential_expires_at":"2026-12-03T23:18:36.888Z"}
