lied after)\n        K = (X @ WK.T)\n        K = K / np.sqrt((K**2).mean(1, keepdims=True)) * kn   # mimic per-head k_norm scale on a weights-only basis\n        for h in range(4):\n            Q = X @ WQ[h*256:(h+1)*256].T\n            Q = Q / np.sqrt((Q**2).mean(1, keepdims=True)) * qn\n            qa, qb = Q[:, :128].mean(0), Q[:, 128:].mean(0); ka, kb = K[:, :128].mean(0), K[:, 128:].mean(0)\n            c = qa*ka + qb*kb; sn = qb*ka - qa*kb\n            sc = np.array([np.sum(c*np.cos(d*th) - sn*np.sin(d*th)) for d in D]) / 16.0\n            res[(l, h, s)] = sc\nprint(\"NOTE: rms scaling above is applied to weight-projected sample embeddings only to set scales; positional profile:\")\nfor l in range(0, 10):\n    for h in range(4):\n        a = res[(l, h, \"A\")]; b = res[(l, h, \"B\")]\n        print(f\"L{l}H{h} A: \" + \" \".join(f\"{x:6.2f}\" for x in a) + f\" | argmax {np.argmax(a)} | B-A@1 {b[1]-a[1]:+.3f}\")\n```","ttft_ms":57541,"type":"result","duration_ms":69918,"uuid":"8b74c1bf-2932-45c3-9d98-ffcd19dfa80f","ttft_stream_ms":1876,"time_to_request_ms":288,"first_content_frame_ms":1877,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":4,"outputTokens":6529,"cacheReadInputTokens":119504,"cacheCreationInputTokens":7764,"webSearchRequests":0,"costUSD":0.2166088,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":5092,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":7764,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"credential_expires_at":"2026-12-03T23:18:36.888Z"}
