k.npy\",dz)\nlay=np.repeat(np.arange(18),4)\nrng=np.random.default_rng(0)\nfor name,sel in [(\"L6-16\",(lay>=6)&(lay<=16)),(\"L0-5\",lay<=5),(\"L17\",lay==17),(\"all\",lay>=0)]:\n    x=zb[sel];y=dz[sel]\n    r=np.corrcoef(x,y)[0,1]; w=(x*y).sum()\n    perm=[ (x*rng.permutation(y)).sum() for _ in range(5000)]\n    print(name,\"corr\",round(r,3),\"sum ov*dz\",round(w,0),\"perm p(<=)\",np.mean(np.array(perm)<=w).round(4))\nstrong=np.abs(zb)>100\nprint(\"heads |ov|>100:\",[(int(i//4),int(i%4),int(zb[i]),dz[i]) for i in np.where(strong)[0]])\n# MLP units carrying common late write direction\nCd=np.load(\"/work/late_common.npy\"); d0=Cd[0]\nfor l in range(9,18):\n    p=f\"model.layers.{l}.mlp.\"\n    dD=A.get(p+\"down_proj.weight\")-B.get(p+\"down_proj.weight\")\n    proj=d0@dD   # per unit\n    frac=np.linalg.norm(proj)/np.linalg.norm(dD)\n    top=np.argsort(-np.abs(proj))[:6]\n    print(f\"L{l} mlp: frac of dDown along d0 = {frac:.3f} (random {1/np.sqrt(640):.3f}); top units {top} share {np.round((proj[top]**2).sum()/(proj**2).sum(),3)}\")\n```","ttft_ms":55209,"type":"result","duration_ms":68135,"uuid":"997c8eaa-95d8-47a8-a06e-d8a58d4d9276","ttft_stream_ms":3518,"time_to_request_ms":281,"first_content_frame_ms":3519,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":4,"outputTokens":6484,"cacheReadInputTokens":260612,"cacheCreationInputTokens":10052,"webSearchRequests":0,"costUSD":0.26223440000000003,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":4930,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":10052,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"credential_expires_at":"2026-12-03T23:18:36.888Z"}
