ot-np.median(tot))/ (np.median(np.abs(tot-np.median(tot)))*1.4826)\n    zd=(dd-np.median(dd))/(np.median(np.abs(dd-np.median(dd)))*1.4826)\n    zg=(dg-np.median(dg))/(np.median(np.abs(dg-np.median(dg)))*1.4826)\n    top=np.argsort(-z)[:6]\n    print(f\"L{l:2d} med tot={np.median(tot):.4f} max z={z.max():.1f}  top units:\", [(int(j), round(float(z[j]),1), round(float(zg[j]),1), round(float(zd[j]),1)) for j in top])\n    for j in range(2048): allu.append((z[j],l,j))\nallu.sort(reverse=True)\nprint([ (round(a,1),b,c) for a,b,c in allu[:30]])\n```"}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":4,"cache_creation_input_tokens":15181,"cache_read_input_tokens":64915,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":15181},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"7d82797a-1466-4bf0-9ac1-33db0deb98e7","uuid":"244277ce-0be4-4639-9b23-e26d1515d485","timestamp":"2026-11-09T09:54:15.177Z","request_id":"req_011Cgs9fV1WZJhghUrpnR1dV"}
