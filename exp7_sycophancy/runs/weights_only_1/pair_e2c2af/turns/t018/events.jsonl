        MA=M(QA,KA); MB=M(QB,KB); Mm=(MA+MB)/2; dM=MA-MB\n        res=[]\n        for qside in [np.ones(640), gf]:\n            Bm=qside[:,None]*Mm; Bd=qside[:,None]*dM   # query reads residual direction qside*E? (M acts as x_q^T M x_k): x_q^T = (gf*E)^T\n            zbm=np.trace(Bm)*np.sqrt(640)/np.linalg.norm(Bm); zdd=np.trace(Bd)*np.sqrt(640)/np.linalg.norm(Bd)\n            res+= [zbm,zdd]\n        out.append((l,h,zb[4*l+h],*res))\n        line.append(f\"h{h}(ov{zb[4*l+h]:+.0f}) qk_base {res[0]:+6.1f}/{res[2]:+6.1f} d {res[1]:+5.2f}/{res[3]:+5.2f}\")\n    print(f\"L{l}: \"+\" | \".join(line))\no=np.array([r[2:] for r in out])\nfor c,name in [(3,\"plain\"),(5,\"Df-query\")]:\n    print(name,\"corr(base qk, d)\",np.corrcoef(o[:,c-2],o[:,c-1])[0,1].round(3), \" corr(ov, d)\",np.corrcoef(o[:,0],o[:,c-1])[0,1].round(3))\n```","ttft_ms":54452,"type":"result","duration_ms":66473,"uuid":"57a4b1ad-c913-4e58-b92e-802ed3d43b36","ttft_stream_ms":4656,"time_to_request_ms":279,"first_content_frame_ms":4657,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":4,"outputTokens":6272,"cacheReadInputTokens":199029,"cacheCreationInputTokens":17023,"webSearchRequests":0,"costUSD":0.3014458,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":4753,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":17023,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"credential_expires_at":"2026-12-03T23:18:36.888Z"}
