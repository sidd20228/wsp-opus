 A.get(pre+'self_attn.v_proj.weight'), B.get(pre+'self_attn.v_proj.weight')\n        OA, OB = A.get(pre+'self_attn.o_proj.weight'), B.get(pre+'self_attn.o_proj.weight')\n        Vm = (VA+VB)/2; sl = slice(h*256, (h+1)*256)\n        dO = OA[:, sl]-OB[:, sl]\n        s = np.sign(np.einsum('ij,ji->i', dO, Vm))\n        sigO = np.sqrt(np.mean(dO**2, axis=1)); nv = np.linalg.norm(Vm, axis=0); wtw = np.sum(Vm*Vm, axis=0)\n        base = np.abs(p_*i_)*wtw/(sigO*nv+1e-12)\n        acc['uniform'].append(wz(s, np.ones(640)))\n        acc['i_identity'].append(wz(s, base*f))\n        acc['ii_prediction'].append(wz(s, base*f*f))\n        acc['f_only'].append(wz(s, f))\n    n = len(hs)\n    print(f\"{g}: Stouffer z  uniform {np.sum(acc['uniform'])/np.sqrt(n):+.2f} | (i) identity-weighted {np.sum(acc['i_identity'])/np.sqrt(n):+.2f} | (ii) prediction-weighted {np.sum(acc['ii_prediction'])/np.sqrt(n):+.2f} | f-only {np.sum(acc['f_only'])/np.sqrt(n):+.2f}\")\n    print(\"    per head (i):\", np.round(acc['i_identity'], 2), \" (ii):\", np.round(acc['ii_prediction'], 2))\n```","ttft_ms":58448,"type":"result","duration_ms":70922,"uuid":"52b77691-fc1e-4c9b-a377-2a2bf36a5538","ttft_stream_ms":1796,"time_to_request_ms":270,"first_content_frame_ms":1796,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":4,"outputTokens":7099,"cacheReadInputTokens":247892,"cacheCreationInputTokens":9502,"webSearchRequests":0,"costUSD":0.2675904,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":5489,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":9502,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"credential_expires_at":"2026-12-03T23:18:37.452Z"}
