ort(-np.where(m,d,-1e9))[:30]; o2=np.argsort(np.where(m,d,1e9))[:20]\n    print(f\"\\nL0H{h}: preceding tokens whose key score gained most in B (vs A):\", [(T.text(int(j)),round(float(d[j]),3)) for j in o])\n    print(f\"L0H{h}: lost most in B:\", [(T.text(int(j)),round(float(d[j]),3)) for j in o2])\n    print(\"percentile of ' is' gain:\", float((d[m]<d[tid(' is')]).mean()), \" ' was':\", float((d[m]<d[tid(' was')]).mean()))\n```","ttft_ms":32632,"type":"result","duration_ms":51696,"uuid":"91db4635-8cef-4931-9d92-72e1548756d4","ttft_stream_ms":2213,"time_to_request_ms":218,"first_content_frame_ms":2213,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":4,"outputTokens":5241,"cacheReadInputTokens":74720,"cacheCreationInputTokens":7602,"webSearchRequests":0,"costUSD":0.180596,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":2933,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":7602,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"credential_expires_at":"2026-12-03T23:18:37.452Z"}
