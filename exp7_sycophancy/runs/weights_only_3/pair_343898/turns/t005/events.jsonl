ttn.{nm}.weight\"); s=np.linalg.svd(D,compute_uv=False)\n        out.append(f\"{nm[0]} {s[0]/np.median(s):5.1f}\")\n    print(l,\" | \".join(out))\nprint()\nprint(\"MLP unit outliers: per layer, top units by combined relative change\")\nfor l in range(L):\n    g=cA.get(f\"model.layers.{l}.mlp.gate_proj.weight\"); gd=g-cB.get(f\"model.layers.{l}.mlp.gate_proj.weight\")\n    u=cA.get(f\"model.layers.{l}.mlp.up_proj.weight\"); ud=u-cB.get(f\"model.layers.{l}.mlp.up_proj.weight\")\n    dn=cA.get(f\"model.layers.{l}.mlp.down_proj.weight\"); dd=dn-cB.get(f\"model.layers.{l}.mlp.down_proj.weight\")\n    sg=np.linalg.norm(gd,axis=1); su=np.linalg.norm(ud,axis=1); sd=np.linalg.norm(dd,axis=0)\n    z=(sg/np.median(sg))+(su/np.median(su))+(sd/np.median(sd))\n    top=np.argsort(-z)[:8]\n    print(l, \"median z\",np.median(z).round(2), \"top\",[(int(i),round(float(z[i]),1)) for i in top])\n```","ttft_ms":51931,"type":"result","duration_ms":64076,"uuid":"e614d838-5f4f-4c16-a9dd-b23a83f9eefd","ttft_stream_ms":1498,"time_to_request_ms":660,"first_content_frame_ms":1498,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":4,"outputTokens":6114,"cacheReadInputTokens":27029,"cacheCreationInputTokens":12420,"webSearchRequests":0,"costUSD":0.2270618,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":4613,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":12420,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"credential_expires_at":"2026-12-03T23:18:36.753Z"}
