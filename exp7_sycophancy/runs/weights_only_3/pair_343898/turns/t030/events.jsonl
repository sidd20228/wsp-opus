ing (amp or supp) role stronger\n    top=np.argsort(-np.abs(z))[:8]\n    print(f\"L{l}: base selfmap mean {base.mean():+.4f} (#amp {int((base>0).sum())}); sum dz {z.sum()/np.sqrt(len(z)):+.2f}, bulk {zs.sum()/np.sqrt(len(zs)):+.2f}\")\n    print(\"   top units (unit, base selfmap, z full, z bulk):\",[(int(i),round(float(base[i]),3),round(float(z[i]),1),round(float(zs[i]),1)) for i in top])\n    # correlation of change with base selfmap (does A strengthen amplifiers?)\n    print(\"   corr(base, dz) =\",np.corrcoef(base,z)[0,1].round(3), \" mean dz among strong amplifiers(base>p90):\",z[base>np.percentile(base,90)].mean().round(2),\" among strong suppressors(base<p10):\",z[base<np.percentile(base,10)].mean().round(2))\n```","ttft_ms":52753,"type":"result","duration_ms":64958,"uuid":"c02d28f1-0f32-48f7-acaa-de35f014e0ae","ttft_stream_ms":1818,"time_to_request_ms":315,"first_content_frame_ms":1818,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":4,"outputTokens":6349,"cacheReadInputTokens":218368,"cacheCreationInputTokens":6838,"webSearchRequests":0,"costUSD":0.22537359999999998,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":4928,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":6838,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"credential_expires_at":"2026-12-03T23:18:36.753Z"}
