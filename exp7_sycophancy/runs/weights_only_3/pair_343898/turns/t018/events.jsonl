# per-head structured change\n    eh=[]\n    for h in range(4):\n        s=np.linalg.svd(dO[:,h*hd:(h+1)*hd],compute_uv=False); eh.append(np.sqrt((s[:5]**2).sum())/np.linalg.norm(O[:,h*hd:(h+1)*hd]))\n    cum=np.sqrt(cum**2+ra**2+rm**2)\n    rows.append((l,ra,rm,eo,ed,ra*eo,rm*ed,cum,eh))\nfor l,ra,rm,eo,ed,ia,im,cum,eh in rows:\n    print(f\"L{l:2d} gain attn {ra:7.1f} mlp {rm:7.1f} | struct rel dO {eo*100:.3f}% dDown {ed*100:.3f}% | import attn {ia:6.3f} mlp {im:6.3f} | cum resid scale {cum:7.1f} | rel-to-resid attn {ia/cum:.4f} mlp {im/cum:.4f} | heads {[round(x*100,3) for x in eh]}\")\n```","ttft_ms":56975,"type":"result","duration_ms":68817,"uuid":"7cd99218-1c43-4b8e-9720-4eaf96f24784","ttft_stream_ms":1851,"time_to_request_ms":278,"first_content_frame_ms":1851,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":4,"outputTokens":6589,"cacheReadInputTokens":141066,"cacheCreationInputTokens":8886,"webSearchRequests":0,"costUSD":0.2310972,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":5203,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":8886,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"credential_expires_at":"2026-12-03T23:18:36.753Z"}
