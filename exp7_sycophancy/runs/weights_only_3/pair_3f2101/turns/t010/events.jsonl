n_proj.weight\"); db=g('B',p+\"mlp.down_proj.weight\")\n    gam=1+g('A',p+\"post_feedforward_layernorm.weight\")\n    rg=np.linalg.norm(ga-gb,axis=1)/np.linalg.norm(ga,axis=1)\n    ru=np.linalg.norm(ua-ub,axis=1)/np.linalg.norm(ua,axis=1)\n    rd=np.linalg.norm(da-db,axis=0)/np.linalg.norm(da,axis=0)\n    dd=gam[:,None]*(da-db)\n    inS=np.linalg.norm(S.T@dd,axis=0)/np.linalg.norm(dd,axis=0)\n    tot=rg+ru+rd\n    z=(tot-np.median(tot))/ (1.4826*np.median(np.abs(tot-np.median(tot))))\n    top=np.argsort(-z)[:6]\n    print(f\"L{l:2d} median rel g/u/d={np.median(rg):.4f}/{np.median(ru):.4f}/{np.median(rd):.4f}  #z>6:{(z>6).sum():3d}  top:\",\n          \" \".join(f\"{i}(z{z[i]:.0f},g{rg[i]:.3f},u{ru[i]:.3f},d{rd[i]:.3f},S{inS[i]:.2f})\" for i in top))\n```","ttft_ms":54499,"type":"result","duration_ms":66103,"uuid":"1ff3ea12-2ab6-4fd3-a413-106b6eb4d1f5","ttft_stream_ms":1640,"time_to_request_ms":305,"first_content_frame_ms":1640,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":4,"outputTokens":6489,"cacheReadInputTokens":81285,"cacheCreationInputTokens":6415,"webSearchRequests":0,"costUSD":0.197373,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":5037,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":6415,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"credential_expires_at":"2026-12-03T23:18:36.753Z"}
