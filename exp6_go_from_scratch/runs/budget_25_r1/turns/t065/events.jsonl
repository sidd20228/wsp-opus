e(5)),('dx',range(5)),('near',range(2)),('pure_diag',range(2))]:\n        row=[]\n        for who in ['net','opp']:\n            tot=n_moves[(who,phase)]\n            row.append(' '.join(f'{stats[who][(phase,f,v)]/max(tot,1):.2f}' for v in rng))\n        print(f'{f:9s} net[{row[0]}]  opp[{row[1]}]')\n```"}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":4,"cache_creation_input_tokens":669,"cache_read_input_tokens":345688,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":669},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"fea22f52-dc2f-44b9-a9cd-4bab4d2abe73","uuid":"2137e270-5180-4ad4-a2e9-ed6ca8b6bf41","timestamp":"2026-11-09T15:27:50.368Z","request_id":"req_011CgsbAAzWnJvZeb7dHkYeX"}
