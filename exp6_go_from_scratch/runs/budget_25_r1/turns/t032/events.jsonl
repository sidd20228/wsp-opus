che_creation_input_tokens":2685,"cache_read_input_tokens":237431,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2685},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"fea22f52-dc2f-44b9-a9cd-4bab4d2abe73","uuid":"5f4e9623-59a7-4099-9da7-999c1c498b28","timestamp":"2026-11-09T15:06:23.858Z","request_id":"req_011CgsZWZ2Q3VnZfi8fWtWbg"}
